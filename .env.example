# 7Eventos - variáveis de ambiente
# Copie para .env.local e ajuste conforme o ambiente.

# --- Fonte de dados -----------------------------------------------------
# "mock"     -> base em memória rica para demonstração (branch develop).
#               Reinicia a cada novo processo do servidor.
# "supabase" -> Postgres/Supabase oficial (branch main), quando o
#               projeto for provisionado. Ver docs/architecture/DATABASE.md.
DATA_MODE=mock

# --- Sessão ---------------------------------------------------------------
# Segredo usado para assinar o cookie de sessão (HMAC-SHA256). Gere um
# valor aleatório forte em produção, ex.: `openssl rand -base64 32`.
SESSION_SECRET=troque-este-valor-em-producao

# --- Supabase (apenas quando DATA_MODE=supabase) --------------------------
# Server-side (nunca expor ao cliente):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side (login por e-mail/senha via Supabase Auth):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Atlas (Fase 3 - docs/FASE_03_ATLAS.md) --------------------------------
# Provedor de IA por trás do Atlas. Só "openai" está implementado hoje
# (src/lib/atlas/providers/) — a variável existe mesmo assim para não
# exigir refatoração se um segundo provedor for avaliado no futuro.
ATLAS_AI_PROVIDER=openai

# Server-side apenas (NUNCA usar NEXT_PUBLIC_OPENAI_API_KEY). Sem esta
# chave, a rota /eventos/[id]/atlas continua acessível mas mostra "Atlas
# não está configurado" em vez de travar a aplicação — ver
# src/lib/atlas/providers/index.ts. NÃO provisionar em Production até a
# validação paga controlada em Preview ser concluída (ver relato do
# validador): Gestor com financeiro, Consulta/Operador sem financeiro,
# evento de outra empresa, resumo com seções vazias, prompt injection,
# histórico adulterado, 401/429/500/timeout/recusa, tokens auditados.
OPENAI_API_KEY=

# Modelo usado pelo Atlas — ainda não há decisão formal de produto sobre
# qual modelo pago usar; o padrão abaixo (se a variável ficar vazia) é
# gpt-5.6-terra (equilíbrio custo/qualidade), mas pode ser trocado sem
# alterar código.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1

# Controle de consumo (docs/FASE_03_ATLAS.md seção 13). Valores abaixo
# são os padrões já embutidos no código (src/lib/atlas/limiter.ts) —
# só defina aqui para sobrescrever. Para a validação paga controlada em
# Preview, começar com limites mais conservadores, ex.:
# ATLAS_MIN_INTERVAL_MS=5000, ATLAS_DAILY_LIMIT_PER_USER=10,
# ATLAS_DAILY_LIMIT_PER_COMPANY=50.
# ATLAS_MIN_INTERVAL_MS=3000
# ATLAS_DAILY_LIMIT_PER_USER=30
# ATLAS_DAILY_LIMIT_PER_COMPANY=300
